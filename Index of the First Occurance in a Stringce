int strStr(char *haystack, char *needle) {
    int n = strlen(haystack);
    int m = strlen(needle);

    if (m == 0)
        return 0;

    int lps[m];
    lps[0] = 0;
    int len = 0, i = 1;

    while (i < m) {
        if (needle[i] == needle[len]) {
            lps[i++] = ++len;
        } else {
            if (len)
                len = lps[len - 1];
            else
                lps[i++] = 0;
        }
    }

    i = 0;
    int j = 0;

    while (i < n) {
        if (haystack[i] == needle[j]) {
            i++;
            j++;

            if (j == m) {
                return i - m;
            }
        } else {
            if (j)
                j = lps[j - 1];
            else
                i++;
        }
    }
    return -1;
}
